# ============================================================
# IT Kanban Board — Kanban Frontend
# Multi-stage build: install deps → vite build → nginx serve
# ============================================================

# ---- Stage 1: build ----------------------------------------
FROM node:24-alpine AS builder

RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /workspace

# Copy workspace manifests
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY patches/ patches/ 2>/dev/null || true

# Copy package.json files for workspace graph resolution
COPY lib/api-spec/package.json             lib/api-spec/
COPY lib/api-client-react/package.json     lib/api-client-react/
COPY lib/api-zod/package.json              lib/api-zod/
COPY lib/db/package.json                   lib/db/
COPY lib/replit-auth-web/package.json      lib/replit-auth-web/
COPY artifacts/kanban/package.json         artifacts/kanban/

RUN pnpm install --frozen-lockfile

# Copy source
COPY tsconfig.json tsconfig.base.json ./
COPY lib/ lib/
COPY artifacts/kanban/ artifacts/kanban/

# Vite requires PORT and BASE_PATH even during build (top-level config reads them)
ARG PORT=3000
ARG BASE_PATH=/

# Build the static site
RUN PORT=${PORT} BASE_PATH=${BASE_PATH} pnpm --filter @workspace/kanban run build

# ---- Stage 2: nginx ----------------------------------------
FROM nginx:1.27-alpine AS runtime

# Remove default nginx content
RUN rm -rf /usr/share/nginx/html/*

# Copy built static files
COPY --from=builder /workspace/artifacts/kanban/dist/public /usr/share/nginx/html

# Kanban-specific nginx config (SPA fallback — all routes serve index.html)
RUN printf 'server {\n\
    listen 3000;\n\
    root /usr/share/nginx/html;\n\
    index index.html;\n\
    location / {\n\
        try_files $uri $uri/ /index.html;\n\
    }\n\
}\n' > /etc/nginx/conf.d/default.conf

EXPOSE 3000

CMD ["nginx", "-g", "daemon off;"]
