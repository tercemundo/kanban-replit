# Copy this file to .env and fill in the values before running docker compose
# cp .env.example .env

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Password for the internal postgres user (the DATABASE_URL is built automatically)
POSTGRES_PASSWORD=change_me_strong_password

# ── Session ───────────────────────────────────────────────────────────────────
# Random secret for signing session cookies. Generate one with:
#   openssl rand -hex 32
SESSION_SECRET=change_me_replace_with_64_hex_chars

# ── Replit Auth (OIDC) ────────────────────────────────────────────────────────
# IMPORTANT: This app uses Replit as the OIDC provider (https://replit.com/oidc).
# REPL_ID must match the ID of your Replit app — find it in your Replit project URL.
# Authentication will NOT work outside of Replit without replacing the OIDC provider.
REPL_ID=your-replit-app-id-here
ISSUER_URL=https://replit.com/oidc

# ── Networking ────────────────────────────────────────────────────────────────
# Host port for the nginx reverse proxy (default: 80)
HTTP_PORT=80
